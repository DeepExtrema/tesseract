<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS equivalent of scripts/librarian-task.cmd (Windows Task Scheduler).
     It already indexes, so don't also install com.tesseract.index.
     Replace {REPO}, {VAULT}, {HOME}; then:
       cp this-file ~/Library/LaunchAgents/com.tesseract.librarian.plist
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.tesseract.librarian.plist
     First run the librarian by hand in dry-run mode (README: Scheduled
     maintenance), review the report, then run it once by hand with
     --confirm-first-run; a scheduled run on a never-swept vault refuses.
     Remove with: launchctl bootout gui/$(id -u)/com.tesseract.librarian -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tesseract.librarian</string>
  <key>ProgramArguments</key>
  <array>
    <string>{REPO}/.venv/bin/python</string>
    <string>-m</string><string>tesseract_mcp.librarian</string>
    <string>{VAULT}</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TESSERACT_EXTRACTOR</key><string>claude</string>
    <!-- unattended extraction reads clipped web content: run the CLI with no tools -->
    <key>TESSERACT_EXTRACTOR_NO_TOOLS</key><string>1</string>
    <key>PATH</key><string>{HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>{HOME}/.tesseract-mcp/librarian-task.log</string>
  <key>StandardErrorPath</key><string>{HOME}/.tesseract-mcp/librarian-task.log</string>
</dict>
</plist>
